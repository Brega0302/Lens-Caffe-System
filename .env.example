# Run npm run db:local for an isolated local PostgreSQL demo database.
# For your own PostgreSQL, replace this URL with your database credentials.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/lensos_dev?schema=public
APP_MODE=production
PORT=3001
LENSOS_TIME_ZONE=Europe/Sarajevo
LENSOS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: password for initial owner creation; never commit actual credentials.
LENSOS_OWNER_USERNAME=owner
LENSOS_OWNER_PASSWORD=
# A disposable database ending in _test is required for integration tests.
TEST_DATABASE_URL=
