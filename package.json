{
  "name": "lensos-cafe-management",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "concurrently --kill-others \"tsx watch server/lensos/index.ts\" \"vite --host 127.0.0.1 --strictPort\"",
    "server": "tsx server/lensos/index.ts",
    "start": "tsx server/lensos/index.ts",
    "legacy:server": "node server/index.js",
    "db:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-postgres.ps1",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:owner": "tsx server/lensos/provision.ts",
    "seed:demo": "tsx server/lensos/seed.ts",
    "build": "vite build",
    "build:desktop:legacy": "vite build && electron-builder",
    "typecheck": "tsc --noEmit && tsc -p server/lensos/tsconfig.json --noEmit",
    "test:postgres": "tsx --test --test-concurrency=1 server/lensos/integration.test.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@tailwindcss/vite": "^4.3.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.9.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "framer-motion": "^12.40.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.3.0",
    "tslib": "^2.8.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.7",
    "concurrently": "^9.2.1",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.7",
    "wait-on": "^9.0.5"
  }
}
